<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Settings</sheetTitle>
                <type>array</type>
                <el>
                    <settings.subject>
                        <label>Subject</label>
                        <config>
                            <type>input</type>
                        </config>
                    </settings.subject>
                    <settings.teasers>
                        <title>Teasers</title>
                        <type>array</type>
                        <section>1</section>
                        <el>
                            <link>
                                <title>Link teaser</title>
                                <type>array</type>
                                <el>
                                    <url>
                                        <label>URL</label>
                                        <config>
                                            <type>input</type>
                                        </config>
                                    </url>
                                </el>
                            </link>
                            <text>
                                <title>Text teaser</title>
                                <type>array</type>
                                <el>
                                    <headline>
                                        <label>Headline</label>
                                        <config>
                                            <type>input</type>
                                        </config>
                                    </headline>
                                    <bodytext>
                                        <label>Text</label>
                                        <config>
                                            <type>text</type>
                                        </config>
                                    </bodytext>
                                </el>
                            </text>
                        </el>
                    </settings.teasers>
                </el>
            </ROOT>
        </sDEF>
        <mail>
            <ROOT>
                <sheetTitle>Mail</sheetTitle>
                <type>array</type>
                <el>
                    <settings.finishers.EmailToReceiver.recipients>
                        <title>Recipients</title>
                        <type>array</type>
                        <section>1</section>
                        <el>
                            <_arrayContainer>
                                <title>Recipient</title>
                                <type>array</type>
                                <el>
                                    <email>
                                        <label>Email</label>
                                        <config>
                                            <type>input</type>
                                        </config>
                                    </email>
                                    <name>
                                        <label>Name</label>
                                        <config>
                                            <type>input</type>
                                        </config>
                                    </name>
                                </el>
                            </_arrayContainer>
                        </el>
                    </settings.finishers.EmailToReceiver.recipients>
                </el>
            </ROOT>
        </mail>
    </sheets>
</T3DataStructure>
